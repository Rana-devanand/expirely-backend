<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Your Expirely Password</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background-color: #0a0a0f;
      color: #e2e8f0;
    }

    .wrapper {
      max-width: 620px;
      margin: 40px auto;
      background: #0a0a0f;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,0.5);
      border: 1px solid rgba(239, 68, 68, 0.15);
    }

    /* ── Header ── */
    .header {
      background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 40%, #b91c1c 100%);
      padding: 48px 40px 40px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .header::before {
      content: '';
      position: absolute;
      top: -60px; left: -60px;
      width: 200px; height: 200px;
      background: rgba(239,68,68,0.15);
      border-radius: 50%;
    }

    .logo-container {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      position: relative;
      z-index: 1;
    }
    .logo-icon {
      width: 48px; height: 48px;
      background: rgba(255,255,255,0.15);
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }
    .logo-text {
      font-size: 24px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
    }

    .badge {
      display: inline-block;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      color: #fca5a5;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 50px;
      margin-bottom: 16px;
      position: relative;
      z-index: 1;
    }

    .header h1 {
      font-size: 30px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.25;
      position: relative;
      z-index: 1;
    }
    .header h1 span { color: #fca5a5; }

    /* ── Body ── */
    .body {
      background: #111118;
      padding: 40px 40px 32px;
    }

    .greeting {
      font-size: 17px;
      color: #94a3b8;
      margin-bottom: 12px;
    }
    .greeting strong { color: #e2e8f0; font-weight: 700; }

    .intro-text {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.7;
      margin-bottom: 32px;
    }

    /* ── Code Box ── */
    .code-box {
      background: #1a1a27;
      border: 1px solid rgba(239,68,68,0.2);
      border-radius: 14px;
      padding: 32px 24px;
      margin-bottom: 28px;
      text-align: center;
    }
    .code-box-title {
      font-size: 12px;
      font-weight: 600;
      color: #ef4444;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 14px;
    }
    .code-value {
      font-size: 38px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 8px;
      font-family: monospace;
      margin-bottom: 14px;
    }
    .code-expiry {
      font-size: 13px;
      color: #64748b;
    }

    /* ── Tips box ── */
    .tips-box {
      background: #271a1a;
      border-left: 3px solid #ef4444;
      border-radius: 0 10px 10px 0;
      padding: 18px 20px;
      margin-bottom: 28px;
    }
    .tips-box p {
      font-size: 13px;
      color: #fca5a5;
      line-height: 1.6;
    }

    /* ── Footer ── */
    .footer {
      background: #0d0d14;
      padding: 28px 40px;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .footer-brand {
      font-size: 15px;
      font-weight: 700;
      color: #ef4444;
      margin-bottom: 8px;
    }
    .footer-text {
      font-size: 12px;
      color: #475569;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <!-- Header -->
    <div class="header">
      <div class="logo-container">
        <span class="logo-icon">⏳</span>
        <span class="logo-text">Expirely</span>
      </div>
      <div><span class="badge">🔒 Security Alert</span></div>
      <h1>Reset Code <span>Requested</span></h1>
    </div>

    <!-- Body -->
    <div class="body">

      <p class="greeting">Hey <strong><%= username %></strong>,</p>
      <p class="intro-text">
        We received a request to reset your Expirely account password. 
        Please enter the verification code below in your mobile app to proceed with resetting your password.
      </p>

      <!-- Code Details -->
      <div class="code-box">
        <div class="code-box-title">Verification Code</div>
        <div class="code-value"><%= code %></div>
        <div class="code-expiry">This code is valid for 15 minutes.</div>
      </div>

      <!-- Tips -->
      <div class="tips-box">
        <p>
          <strong>⚠️ Security Reminder:</strong> If you did not make this request, you can safely ignore this email.
          Your password will remain secure and unchanged. Do not share this code with anyone.
        </p>
      </div>

    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-brand">⏳ Expirely</div>
      <p class="footer-text">
        &copy; <%= new Date().getFullYear() %> Expirely. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
