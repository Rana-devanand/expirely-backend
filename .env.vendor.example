# Vendor discovery is server-side only. Never use an EXPO_PUBLIC_ prefix here.
ENABLE_VENDOR_MARKETPLACE=true
ENABLE_VENDOR_DISCOVERY=true
ENABLE_VENDOR_EXTERNAL_DISCOVERY=true
GEOAPIFY_API_KEY=replace_with_your_server_key

# Optional: successful area imports stay fresh for 72 hours by default.
VENDOR_DISCOVERY_CACHE_HOURS=72
